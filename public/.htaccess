RewriteEngine On
RewriteBase /

# Keep admin Authorization header
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Do not rewrite the API folder
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^ - [L]

# Do not rewrite real files (css, js, images, php)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Send every page URL to the app
RewriteRule ^(.*)$ index.php [L]
